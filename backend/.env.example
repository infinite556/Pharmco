DB_URL=mongodb://localhost:27017/your_database
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_NAME=accessToken
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# Must include both /refresh and /logout so logout can revoke the session.
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
COOKIE_SAME_SITE=lax
# Set COOKIE_DOMAIN only when a shared parent domain is required.
# COOKIE_DOMAIN=example.com
# Comma-separated browser origins allowed to send state-changing requests.
# TRUSTED_ORIGINS=http://localhost:3000
